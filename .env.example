# Copy thanh .env va chi dung vi test. Tuyet doi khong commit .env.
LOCAL_RPC_URL=http://127.0.0.1:8545
# Dashboard network selection is atomic. Leave BOTH SSI_* variables absent for
# the local fallback above (chain 31337), or set BOTH for a selected network.
# SSI_RPC_URL=https://sepolia.example.invalid/v3/REPLACE_ME
# SSI_EXPECTED_CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/REPLACE_ME
# Required together only by the Sepolia deployment/role commands. Values are
# exact decimal gwei, not secrets. Local commands keep their existing defaults.
SSI_DEPLOY_MAX_FEE_GWEI=1
SSI_DEPLOY_MAX_PRIORITY_FEE_GWEI=0.1
DEPLOYER_PRIVATE_KEY=0xREPLACE_WITH_TESTNET_KEY_ONLY
HOLDER_PRIVATE_KEY=0xREPLACE_WITH_LOCAL_OR_TESTNET_KEY_ONLY
ISSUER_PRIVATE_KEY=0xREPLACE_WITH_LOCAL_OR_TESTNET_KEY_ONLY
VERIFIER_PRIVATE_KEY=0xREPLACE_WITH_LOCAL_OR_TESTNET_KEY_ONLY
HOLDER_RSA_PASSWORD=REPLACE_ME
ISSUER_RSA_PASSWORD=REPLACE_ME
VERIFIER_RSA_PASSWORD=REPLACE_ME
ISSUER_ADDRESS=0xREPLACE_ME
VERIFIER_ADDRESS=0xREPLACE_ME
SSI_REGISTRY_ADDRESS=0xREPLACE_AFTER_DEPLOY
IDENTITY_SBT_ADDRESS=0xREPLACE_AFTER_DEPLOY
GATED_SERVICE_ADDRESS=0xREPLACE_AFTER_DEPLOY
IPFS_API_URL=http://127.0.0.1:5001
